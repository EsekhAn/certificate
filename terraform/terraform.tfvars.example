zone                  = "ru-central1-d"
project               = "devops-cert"
environment           = "stage"
vm_cores              = 2
vm_memory             = 4
core_fraction         = 20
disk_size             = 20
disk_type             = "network-ssd"
stage_disk_type       = "network-hdd"
ssh_public_key_path   = "~/.ssh/devops-cert.pub"
image_name            = "hello"
allowed_ssh_cidr      = "203.0.113.10/32"
allowed_app_cidr      = "0.0.0.0/0"
